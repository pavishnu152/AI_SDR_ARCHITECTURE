# --- LLM ---
GEMINI_API_KEY=your_actual_gemini_api_key
RESEARCH_SCORING_MODEL="gemini-3.6-flash"
DRAFTING_GUARDRAIL_MODEL="gemini-3.6-flash"


# --- Database ---
DATABASE_URL=postgresql+psycopg2://ai_sdr:ai_sdr@localhost:5432/ai_sdr

# --- Auth ---
JWT_SECRET_KEY=your_long_random_secret_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
ICP_CONFIG_PATH=configs/icp_ai_native_b2b.yaml

# --- CORS (origins the frontend/ dashboard is served from) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
