# --- LLM ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
RESEARCH_SCORING_MODEL=claude-haiku-4-5-20251001
DRAFTING_GUARDRAIL_MODEL=claude-sonnet-5

# --- Database ---
DATABASE_URL=postgresql+psycopg2://ai_sdr:ai_sdr@localhost:5432/ai_sdr

# --- Auth ---
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
ICP_CONFIG_PATH=configs/icp_ai_native_b2b.yaml

# --- CORS (origins the frontend/ dashboard is served from) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
